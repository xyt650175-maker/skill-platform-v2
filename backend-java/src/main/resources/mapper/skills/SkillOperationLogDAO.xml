<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.company.llmaif.skills.dao.SkillOperationLogDAO">

    <select id="selectPageBySkillId" resultType="com.company.llmaif.skills.dao.entity.SkillOperationLogEntity">
        SELECT * FROM skill_operation_log
        WHERE skill_id = #{skillId}
        ORDER BY create_time DESC
    </select>

</mapper>
